# Sprintsight environment template.
# Copy to .env and fill in real values. NEVER commit the real .env (it is gitignored under SS-1.2).
# All values below are placeholders.

# --- App ---
APP_ENV=development
LOG_LEVEL=info

# --- Anthropic (Claude) ---
# Zero Data Retention is required on all data traffic.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Supabase (managed, UK/EU region) ---
# Postgres + pgvector + Auth + storage all live here. Encryption at rest.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Direct Postgres connection string (used for pgvector and migrations).
DATABASE_URL=postgresql://postgres:[password]@db.your-project-ref.supabase.co:5432/postgres

# --- Langfuse (observability + evals; self-hostable, favours the gov story) ---
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Embeddings ---
# Vector dimension is LOCKED at 1024 (see docs/schema/schema-design.md).
# Exact in-region, self-hostable model is finalised at Stage 1 under eval.
EMBEDDING_MODEL=
EMBEDDING_DIM=1024
